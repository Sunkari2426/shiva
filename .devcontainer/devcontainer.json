{
  "name": "Scrap Mama",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": {"label": "Scrap Mama Web", "onAutoForward": "openPreview"},
    "4000": {"label": "Scrap Mama API", "onAutoForward": "notify"}
  },
  "postCreateCommand": "npm install && cd server && npm install"
}